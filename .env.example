# Copy this file to .env and fill in your own values.
# .env is gitignored so your settings stay local.

# Path to the SQLite database file.
LIVING_LIBRARY_DB_PATH=data/akashic.db

# Number of newest snapshots to keep for each operation (reembed, retitle,
# resummarize). Older snapshots for that operation are removed after a backup.
LIVING_LIBRARY_BACKUP_RETENTION=5

# Name of the embedding model used for semantic search.
# IMPORTANT: keep this fixed once you start storing data. All vectors in the
# database must come from the SAME model, or similarity search is meaningless.
LIVING_LIBRARY_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Which backend produces conversation summaries at ingest time.
#   extractive     - default; local, offline, no extra services (centroid
#                    sentence-ranking over the embedding model above).
#   ollama:<model> - abstractive summaries from a local Ollama model,
#                    e.g. ollama:llama3. Requires Ollama running.
# Extractive summaries use a 300-character budget. Ollama gets a generous
# 1,200-character soft cap at sentence boundaries; an overlong single sentence
# is kept intact rather than sliced mid-sentence.
# Unlike the embedder, this may change freely between saves; each conversation
# records which backend produced its summary.
LIVING_LIBRARY_SUMMARIZER=extractive

# Base URL of the Ollama server (only used by the ollama summarizer backend).
LIVING_LIBRARY_OLLAMA_HOST=http://localhost:11434

# Title backend: "heuristic" (default, offline) or "ollama:<model>". An Ollama
# failure falls back to heuristic so saves never fail over a title.
LIVING_LIBRARY_TITLER=heuristic

# Minimum flattened transcript length for the Claude Code auto-save hook.
# Sessions shorter than this are ignored until a later turn grows the transcript.
# Set to 0 to save every session.
LIVING_LIBRARY_MIN_SESSION_CHARS=200
# Derived data policy for the Claude Code auto-save hook. session_end requires
# registering the command for both Stop and SessionEnd hook events.
LIVING_LIBRARY_SUMMARY_POLICY=each_turn
