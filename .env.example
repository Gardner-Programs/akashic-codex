# Database path (default: ~/.living-library/living-library.db)
LIVING_LIBRARY_DB_PATH=~/.living-library/living-library.db

# Embedding model (fixed per store; changing requires re-embed)
LIVING_LIBRARY_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Summarizer backend: extractive (default, offline) or ollama:<model>
LIVING_LIBRARY_SUMMARIZER=extractive

# Ollama host (for summarizer and titler)
LIVING_LIBRARY_OLLAMA_HOST=http://localhost:11434

# Titler backend: heuristic (default, offline) or ollama:<model>
LIVING_LIBRARY_TITLER=heuristic

# Summary policy for Claude Code hook: each_turn (default) or session_end
LIVING_LIBRARY_SUMMARY_POLICY=each_turn

# Minimum session length for auto-save (chars, default 200)
LIVING_LIBRARY_MIN_SESSION_CHARS=200

# Backup retention per operation label (default 5)
LIVING_LIBRARY_BACKUP_RETENTION=5

# Legacy aliases (deprecated, will be removed)
# AKASHIC_DB_PATH
# AKASHIC_EMBEDDING_MODEL
# AKASHIC_SUMMARIZER
# AKASHIC_OLLAMA_HOST
# AKASHIC_TITLER
# AKASHIC_SUMMARY_POLICY
# AKASHIC_MIN_SESSION_CHARS
# AKASHIC_BACKUP_RETENTION
